generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  slug                 String               @unique
  isActive             Boolean?             @default(true) @map("is_active")
  createdAt            DateTime?            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  email                String?
  phone                String?
  subscriptionStatus   String?              @default("ACTIVE") @map("subscription_status")
  subscriptionExpiresAt DateTime?           @map("subscription_expires_at") @db.Timestamptz(6)
  notes                String?
  payments             TenantPayment[]
  branches             Branch[]
  categories           Category[]
  ingredientCategories IngredientCategory[]
  ingredients          Ingredient[]
  orderItems           OrderItem[]
  orders               Order[]
  products             Product[]
  users                User[]
  recipeItems          RecipeItem[]
  stockMovements       StockMovement[]
  tables               tables[]
  cashSessions         CashSession[]
  deliveryZones        DeliveryZone[]
  deliverySettings     DeliverySettings[]
  deliveryDrivers      DeliveryDriver[]
  waiters              Waiter[]
  webSettings          WebSettings[]
  webOrders            WebOrder[]
  webOrderItems        WebOrderItem[]
  modifierGroups       ModifierGroup[]
  modifierOptions      ModifierOption[]

  @@map("tenants")
}

model Branch {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  location    String?
  email       String?
  phone       String?
  isActive    Boolean?     @default(true) @map("is_active")
  createdAt   DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  subscriptionStatus    String?   @map("subscription_status")
  subscriptionExpiresAt DateTime? @map("subscription_expires_at") @db.Timestamptz(6)
  lastPaymentAt         DateTime? @map("last_payment_at") @db.Timestamptz(6)
  tenantId    String       @map("tenant_id") @db.Uuid
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_branches_tenant")
  ingredients Ingredient[]
  orders      Order[]
  products    Product[]
  users       User[]
  tables      tables[]
  cashSessions CashSession[]
  deliveryZones    DeliveryZone[]
  deliverySettings DeliverySettings[]
  deliveryDrivers  DeliveryDriver[]
  waiters          Waiter[]
  webSettings      WebSettings[]
  webOrders        WebOrder[]
  modifierGroups   ModifierGroup[]

  @@map("branches")
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  email     String
  role      String?   @default("CASHIER")
  branchId  String?   @map("branch_id") @db.Uuid
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  name      String?
  tenantId  String?    @map("tenant_id") @db.Uuid
  password  String?
  full_name String?
  is_active Boolean?  @default(true)
  orders    Order[]
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_profiles_tenant")
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stockMovements StockMovement[]
  cajasAbiertas  CashSession[] @relation("CajaAbiertaPor")
  cajasCerradas  CashSession[] @relation("CajaCerradaPor")
  webOrdersConfirmados WebOrder[]

  @@map("profiles")
}

/// Historial de pagos de suscripción. El estado vigente de cada cliente
/// (tenants.subscriptionExpiresAt) se deriva del último pago registrado.
model TenantPayment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  amount      Decimal?  @db.Decimal(12, 2)
  currency    String?   @default("ARS")
  paidAt      DateTime  @default(now()) @map("paid_at") @db.Timestamptz(6)
  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime  @map("period_end") @db.Date
  method      String?
  notes       String?
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, paidAt(sort: Desc)], map: "idx_tenant_payments_tenant")
  @@map("tenant_payments")
}

model Category {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String    @unique
  imageUrl     String?   @map("image_url")
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  tenantId     String    @map("tenant_id") @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_categories_tenant")
  products     Product[]

  @@index([tenantId, displayOrder], map: "idx_categories_tenant_orden")
  @@map("categories")
}

model Product {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  price      Decimal      @db.Decimal(10, 2)
  categoryId String?      @map("category_id") @db.Uuid
  image      String?      @map("image_url")
  branchId   String?      @map("branch_id") @db.Uuid
  isActive   Boolean?     @default(true) @map("is_active")
  createdAt  DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  tenantId   String       @map("tenant_id") @db.Uuid
  orderItems OrderItem[]
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_products_tenant")
  branch     Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category   Category?    @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipe     RecipeItem[]
  webOrderItems WebOrderItem[]
  modifierGroups ModifierGroup[]

  @@index([branchId, isActive], map: "idx_products_branch_active")
  @@index([branchId], map: "idx_products_branch_id")
  @@index([categoryId], map: "idx_products_category_id")
  @@map("products")
}

model Ingredient {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  stock       Decimal             @default(0) @db.Decimal(10, 3)
  unit        String
  minStock    Decimal             @default(0) @map("min_stock") @db.Decimal(10, 3)
  branchId    String?             @map("branch_id") @db.Uuid
  createdAt   DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  categoryId  String?             @map("category_id") @db.Uuid
  is_active   Boolean?            @default(true)
  tenantId    String              @map("tenant_id") @db.Uuid
  category    IngredientCategory? @relation(fields: [categoryId], references: [id], onUpdate: NoAction, map: "fk_ingredients_category")
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ingredients_tenant")
  branch      Branch?             @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipeItems RecipeItem[]
  stockMovements StockMovement[]

  @@map("ingredients")
}

model IngredientCategory {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String       @unique
  createdAt   DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantId    String       @map("tenant_id") @db.Uuid
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ingredient_categories_tenant")
  ingredients Ingredient[]

  @@map("ingredient_categories")
}

model StockMovement {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ingredientId String        @map("ingredient_id") @db.Uuid
  ingredient   Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  userId       String?       @map("user_id") @db.Uuid
  user         User?         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type         movement_type @default(ADJUST)
  quantity     Decimal       @db.Decimal(10, 3)
  stockBefore  Decimal       @map("stock_before") @db.Decimal(10, 3)
  stockAfter   Decimal       @map("stock_after") @db.Decimal(10, 3)
  reason       String?
  createdAt    DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenantId     String        @map("tenant_id") @db.Uuid
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_stock_movements_tenant")

  @@index([createdAt(sort: Desc)], map: "idx_stock_movements_created")
  @@index([ingredientId], map: "idx_stock_movements_ingredient")
  @@index([userId], map: "idx_stock_movements_user")
  @@map("stock_movements")
}

model RecipeItem {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String?     @map("product_id") @db.Uuid
  ingredientId String?     @map("ingredient_id") @db.Uuid
  quantity     Decimal     @db.Decimal(10, 3)
  tenantId     String      @map("tenant_id") @db.Uuid
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_recipes_tenant")
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product      Product?    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([productId, ingredientId])
  @@map("recipes")
}

model Order {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber      Int         @default(autoincrement()) @map("ticket_number")
  status           OrderStatus?  @default(PENDING)
  total            Decimal     @db.Decimal(10, 2)
  payment_method   String?
  customer_name    String?
  customer_address String?
  order_type       String?     @default("TAKEAWAY")
  table_id         String?     @db.Uuid
  branchId         String?     @map("branch_id") @db.Uuid
  userId           String?     @map("user_id") @db.Uuid
  started_at       DateTime?   @db.Timestamptz(6)
  ready_at         DateTime?   @db.Timestamptz(6)
  deliveryFee      Decimal     @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  deliveryKm       Decimal?    @map("delivery_km") @db.Decimal(10, 2)
  deliveryZoneId   String?     @map("delivery_zone_id") @db.Uuid
  deliveryDriverId String?     @map("delivery_driver_id") @db.Uuid
  customerPhone    String?     @map("customer_phone")
  notes            String?
  waiterId         String?     @map("waiter_id") @db.Uuid
  /// Se congela al crear el pedido: subirle la comisión a un mozo no puede
  /// cambiar lo que ya se le liquidó.
  waiterCommissionPct Decimal? @map("waiter_commission_pct") @db.Decimal(5, 2)
  createdAt        DateTime?   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime?   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantId         String      @map("tenant_id") @db.Uuid
  items            OrderItem[]
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_orders_tenant")
  branch           Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tables           tables?     @relation(fields: [table_id], references: [id], onUpdate: NoAction)
  user             User?       @relation(fields: [userId], references: [id], onUpdate: NoAction)
  deliveryZone     DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deliveryDriver   DeliveryDriver? @relation(fields: [deliveryDriverId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  waiter           Waiter?     @relation(fields: [waiterId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  webOrder         WebOrder?

  @@index([waiterId, createdAt(sort: Desc)], map: "idx_orders_waiter")
  @@index([branchId], map: "idx_orders_branch_id")
  @@index([status], map: "idx_orders_status")
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String?  @map("order_id") @db.Uuid
  productId String?  @map("product_id") @db.Uuid
  quantity  Int
  price     Decimal  @map("unit_price") @db.Decimal(10, 2)
  modifiers Json?
  notes     String?
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_order_items_tenant")
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("order_items")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tables {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id     String?   @db.Uuid
  number        Int
  label         String?
  capacity      Int?      @default(2)
  status        String?   @default("FREE")
  customer_name String?
  notes         String?
  opened_at     DateTime? @db.Timestamptz(6)
  waiter_id     String?   @db.Uuid
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  tenant_id     String    @db.Uuid
  orders        Order[]
  waiter        Waiter?   @relation(fields: [waiter_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tenants       Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tables_tenant")
  branches      Branch?   @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([branch_id, number])
}

/// Turno de caja. Los montos calculados se congelan al cerrar: si después se
/// anula un pedido, el arqueo de ese día no se mueve.
model CashSession {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  openedById     String?   @map("opened_by") @db.Uuid
  closedById     String?   @map("closed_by") @db.Uuid
  openingAmount  Decimal   @default(0) @map("opening_amount") @db.Decimal(12, 2)
  countedAmount  Decimal?  @map("counted_amount") @db.Decimal(12, 2)
  cashSales      Decimal?  @map("cash_sales") @db.Decimal(12, 2)
  expectedAmount Decimal?  @map("expected_amount") @db.Decimal(12, 2)
  difference     Decimal?  @db.Decimal(12, 2)
  status         String    @default("OPEN")
  openingNotes   String?   @map("opening_notes")
  closingNotes   String?   @map("closing_notes")
  openedAt       DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branch         Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  openedBy       User?     @relation("CajaAbiertaPor", fields: [openedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  closedBy       User?     @relation("CajaCerradaPor", fields: [closedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([branchId, openedAt(sort: Desc)], map: "idx_cash_sessions_historial")
  @@map("cash_sessions")
}

/// Área de reparto con precio fijo. Zona y barrio son lo mismo para el sistema:
/// el local decide si la llama "Centro" o "Villa Crespo".
model Waiter {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String
  phone     String?
  commissionPct Decimal @default(0) @map("commission_pct") @db.Decimal(5, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tables    tables[]
  orders    Order[]

  @@index([branchId, isActive], map: "idx_waiters_branch")
  @@map("waiters")
}

model DeliveryZone {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String
  price     Decimal  @default(0) @db.Decimal(10, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders    Order[]
  webOrders WebOrder[]

  @@index([branchId, isActive], map: "idx_delivery_zones_branch")
  @@map("delivery_zones")
}

/// Cobro por distancia: una fila por sucursal. Con kmEnabled en false el POS ni
/// ofrece la opción y el local trabaja sólo con zonas.
model DeliverySettings {
  branchId    String   @id @map("branch_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  deliveryEnabled Boolean @default(true) @map("delivery_enabled")
  kmEnabled   Boolean  @default(false) @map("km_enabled")
  kmBasePrice Decimal  @default(0) @map("km_base_price") @db.Decimal(10, 2)
  kmPrice     Decimal  @default(0) @map("km_price") @db.Decimal(10, 2)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("delivery_settings")
}

model DeliveryDriver {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders    Order[]

  @@index([branchId, isActive], map: "idx_delivery_drivers_branch")
  @@map("delivery_drivers")
}

/// Configuración del canal de venta online, una fila por sucursal.
/// Tabla propia y no una columna en DeliverySettings: por la web también se
/// pide para retirar, y un local que no reparte igual quiere vender online.
model WebSettings {
  branchId        String   @id @map("branch_id") @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  enabled         Boolean  @default(false)
  /// El "hoy no damos abasto", distinto de apagar el canal entero.
  paused          Boolean  @default(false)
  /// Sólo dígitos: es lo que va en el link de wa.me.
  whatsappPhone   String?  @map("whatsapp_phone")
  minOrder        Decimal  @default(0) @map("min_order") @db.Decimal(10, 2)
  acceptsCash     Boolean  @default(true) @map("accepts_cash")
  acceptsTransfer Boolean  @default(false) @map("accepts_transfer")
  transferInfo    String?  @map("transfer_info")
  takeawayEnabled Boolean  @default(true) @map("takeaway_enabled")
  prepMinutes     Int?     @map("prep_minutes")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("web_settings")
}

/// Pedido que entra por la web. Vive acá y no en Order porque no es una venta
/// hasta que el local lo confirma: el Financiero y el arqueo de caja suman
/// todos los pedidos sin mirar el estado.
model WebOrder {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  code            BigInt    @default(dbgenerated("nextval('web_orders_code_seq')"))
  status          String    @default("PENDING")
  customerName    String    @map("customer_name")
  customerPhone   String    @map("customer_phone")
  customerAddress String?   @map("customer_address")
  orderType       String    @map("order_type")
  paymentMethod   String    @map("payment_method")
  notes           String?
  /// Congelados al momento de pedir: es lo que el cliente vio al confirmar.
  itemsTotal      Decimal   @map("items_total") @db.Decimal(10, 2)
  deliveryFee     Decimal   @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  deliveryZoneId  String?   @map("delivery_zone_id") @db.Uuid
  /// La genera el navegador: volver atrás desde WhatsApp y reenviar es lo
  /// normal, no la excepción.
  idempotencyKey  String    @map("idempotency_key") @db.Uuid
  createdMinute   DateTime  @default(now()) @map("created_minute") @db.Timestamptz(6)
  clientIp        String?   @map("client_ip") @db.Inet
  orderId         String?   @unique @map("order_id") @db.Uuid
  confirmedById   String?   @map("confirmed_by") @db.Uuid
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)
  rejectedReason  String?   @map("rejected_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deliveryZone    DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  order           Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  confirmedBy     User?     @relation(fields: [confirmedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items           WebOrderItem[]

  @@index([branchId, status, createdAt(sort: Desc)], map: "idx_web_orders_bandeja")
  @@map("web_orders")
}

/// El nombre y el precio quedan escritos acá: entre que el cliente pidió y el
/// local confirmó, el dueño pudo remarcar o renombrar. El local tiene que ver
/// exactamente lo que el cliente aceptó pagar.
model WebOrderItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  webOrderId  String   @map("web_order_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  productName String   @map("product_name")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity    Int
  notes       String?
  /// Extras elegidos, congelados como [{label, price}]. Mismo formato que ya
  /// usa order_items.modifiers, para que el ticket y la cocina no necesiten un
  /// caso especial según el pedido haya entrado por caja o por la web.
  modifiers   Json?
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  webOrder    WebOrder @relation(fields: [webOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([webOrderId], map: "idx_web_order_items_pedido")
  @@map("web_order_items")
}

/// Grupo de extras propio de un producto ("Agranda tu burger"). Cargado desde
/// cero por producto, sin compartir nada con otros: así lo pidió el dueño.
model ModifierGroup {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  name         String
  minSelect    Int      @default(0) @map("min_select")
  /// NULL = sin techo (multi-selección libre). 1 = elegir una sola (radio).
  maxSelect    Int?     @map("max_select")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  options      ModifierOption[]

  @@index([productId, displayOrder], map: "idx_modifier_groups_producto")
  @@map("modifier_groups")
}

model ModifierOption {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  groupId      String        @map("group_id") @db.Uuid
  name         String
  price        Decimal       @default(0) @db.Decimal(10, 2)
  displayOrder Int           @default(0) @map("display_order")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  group        ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([groupId, displayOrder], map: "idx_modifier_options_grupo")
  @@map("modifier_options")
}

enum movement_type {
  ADD
  REMOVE
  ADJUST
  INITIAL
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}
