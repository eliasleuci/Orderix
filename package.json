{
  "name": "orderix-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --prefix client",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build:prod": "cd server && npm install && npx prisma generate && cd ../client && npm install && npm run build -- --base=/",
    "install:all": "npm install --workspaces",
    "postinstall": "cd server && npx prisma generate"
  }
}
