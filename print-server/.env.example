# ============================================================
# Servidor de impresión - Orderix
# Copiar a .env y ajustar según la impresora.
# ============================================================

# simulacion | red | windows
#   simulacion -> no imprime, guarda los tickets en tickets/ para revisar
#                 el formato. Es el modo por defecto y sirve para probar
#                 todo el circuito sin tener la impresora.
#   red        -> impresora con puerto de red (RJ45 o WiFi). Es el modo más
#                 confiable: no necesita instalar drivers.
#   windows    -> impresora USB instalada en Windows con su driver.
PRINTER_TYPE=simulacion

# Sólo para PRINTER_TYPE=red. El 9100 es el puerto estándar de las térmicas.
PRINTER_HOST=192.168.0.100
PRINTER_PORT=9100

# Sólo para PRINTER_TYPE=windows. El nombre EXACTO como figura en
# Configuración > Impresoras y escáneres.
PRINTER_NAME=

# Qué se imprime solo al confirmar un pedido:
#   both     -> comanda de cocina + ticket del cliente
#   kitchen  -> sólo la comanda de cocina
#   customer -> sólo el ticket del cliente
#   none     -> nada automático, sólo con los botones del POS
PRINT_ON_ORDER=both

PORT=3001
